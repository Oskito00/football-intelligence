ENV=dev

# Local PostgreSQL connection used by Database Setup, API reads, and operational workflows.
# Replace these placeholder credentials with your local database role.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=football_intelligence
DB_USER=football
DB_PASSWORD=football

# Optional deployment-style database URL. ProductionConfig reads this when ENV=prod.
DATABASE_URL=postgresql+psycopg2://football:football@localhost:5432/football_intelligence

# Required only for Source Data Ingestion and odds refresh against API-Football.
API_FOOTBALL_KEY=

# Required only when using the Football Intelligence Agent chat API with the default Groq adapter.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Frontend local development default.
VITE_API_URL=http://localhost:5000
