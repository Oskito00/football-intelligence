FROM python:3.9-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.operations.txt .
RUN pip install --no-cache-dir -r requirements.operations.txt

COPY . .

CMD ["python", "-m", "football_intelligence.cli", "prediction-refresh"]
